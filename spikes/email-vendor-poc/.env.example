# SWEEGO_API_KEY must be the dashboard's "Api-Key" field value (Credentials > API > click
# the key > the masked field, not the "Key ID" shown next to it -- the two look similar
# but are different values; only Api-Key works in the Api-Key header).
SWEEGO_API_KEY=your-sweego-api-key
SWEEGO_API_SECRET=your-sweego-key-id-unused-by-this-spike
SWEEGO_SMTP_HOST=smtp-host:port
SWEEGO_SENDER_DOMAIN=your-verified-sending-domain

LETTERMINT_PROJECT_TOKEN=lm_team_your-project-token
